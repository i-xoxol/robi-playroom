# Copy to .env.local; never commit the completed file.
NODE_ENV=development
HOST=127.0.0.1
PORT=8093
PUBLIC_ORIGIN=http://127.0.0.1:8093
ROBOT_DB=./data/robot.db
# Run node scripts/password-hash.mjs and paste its output below.
ROBOT_PASSWORD_HASH=
# Optional for live conversation. Prepared games work without a provider key.
OPENAI_API_KEY=
# Independent flags. Parent authorization does not assert provider ZDR approval.
CHILD_VOICE_PARENT_AUTHORIZED=false
CHILD_VOICE_ZDR_APPROVED=false
# Optional absolute path to a private JSON file with the fields described in
# docs/architecture.md. Seeds a new database once; later edits use parent settings.
ROBOT_FAMILY_PROFILE=
